# API Configuration
VITE_API_BASE_URL=https://localhost:7084/api/v1

# Origin of the separately-deployed admin console. Set in the fan/artist build
# so an admin landing on "/" is sent to the console on its own origin. Leave
# unset for local development or the combined single-origin build, where the
# in-app /admin route is used instead. Public value, not a secret.
# VITE_ADMIN_URL=https://admin.getmuxify.com
