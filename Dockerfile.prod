# Production image: build the SPA, then serve the static output with nginx.
#
# The sibling `Dockerfile` runs the Vite dev server and is for local development only — it must
# never be used in production. Build this one with docker-compose.prod.yml, which supplies the
# build args below.

FROM node:20-alpine AS build
WORKDIR /app

# Copy manifests first so `npm ci` is cached independently of source changes.
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY . .

# Vite inlines import.meta.env.VITE_* at BUILD time, so these have to be build args — setting them
# as runtime environment variables on the container does nothing at all.
ARG VITE_API_BASE_URL
ARG VITE_LOCATION_API_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_LOCATION_API_KEY=$VITE_LOCATION_API_KEY

# `npm run build` runs `tsc -b` first, so a type error fails the image build. Deliberate.
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
